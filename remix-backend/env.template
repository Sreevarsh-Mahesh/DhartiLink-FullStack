# 🚀 REMIX BACKEND ENVIRONMENT CONFIGURATION
# Follow the BEGINNER_SETUP_GUIDE.md for step-by-step instructions

# ============================================
# 1. INFURA SETUP (Free - takes 5 minutes)
# ============================================
# Go to https://infura.io → Create account → New project → Copy Project ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/PASTE_YOUR_INFURA_PROJECT_ID_HERE
INFURA_PROJECT_ID=PASTE_YOUR_INFURA_PROJECT_ID_HERE

# ============================================
# 2. METAMASK SETUP (Free - takes 5 minutes)
# ============================================
# Install MetaMask → Create wallet → Copy address and private key
PRIVATE_KEY=PASTE_YOUR_METAMASK_PRIVATE_KEY_HERE
WALLET_ADDRESS=PASTE_YOUR_METAMASK_WALLET_ADDRESS_HERE

# ============================================
# 3. CONTRACT ADDRESSES (From Remix deployment)
# ============================================
# Deploy contracts in Remix IDE → Copy addresses
LT_TOKEN_ADDRESS=PASTE_YOUR_LT_TOKEN_CONTRACT_ADDRESS_HERE
LAND_NFT_ADDRESS=PASTE_YOUR_LAND_NFT_CONTRACT_ADDRESS_HERE

# ============================================
# 4. SERVER CONFIGURATION (No changes needed)
# ============================================
PORT=3001
NODE_ENV=development
ETHERSCAN_API_KEY=

# ============================================
# 📝 INSTRUCTIONS:
# ============================================
# 1. Copy this file: cp env.template .env
# 2. Replace all "PASTE_YOUR_*_HERE" with actual values
# 3. Follow BEGINNER_SETUP_GUIDE.md for detailed steps
# 4. Start server: npm run dev
